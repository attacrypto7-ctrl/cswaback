# Salin ke .env (jangan commit). Di Railway: isi via tab Variables per service.
# NOTE: kunci sb_publishable_/sb_secret_ milik Supabase API — backend ini TIDAK
# memakainya. Yang dibutuhkan adalah DATABASE_URL (connection string Postgres).
# Jika Postgres-nya Supabase: Dashboard Supabase → Settings → Database →
# Connection string (gunakan pooler untuk Railway).

# Semua service
DATABASE_URL=postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres
REDIS_URL=redis://localhost:6379

# Service api & worker
GROQ_API_KEY=gsk_...
JWT_SECRET=isi-dengan-string-acak-panjang
ENCRYPTION_KEY=isi-dengan-string-acak-32-karakter-minimal
INTERNAL_SECRET=isi-dengan-string-acak-untuk-antar-service
INTERNAL_API_URL=http://localhost:3000/api

# Google OAuth (Backend full redirect like Shopee)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:8080

# Service wa-gateway
WA_GATEWAY_URL=http://localhost:3002
WA_SESSION_VOLUME_PATH=/data/wa-sessions
PORT=3000
NODE_ENV=development
